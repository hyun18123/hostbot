# ---------------------------------------------------------------------------
# Discord Bot Hosting - environment template
# Copy to .env (never commit .env) and fill in real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# ----- API server ----------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# Public base URL of the API (used in docs / web dashboard callbacks)
API_PUBLIC_URL=http://localhost:3001

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Shared secret used by the Discord management bot -> API
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_API_KEY=CHANGE_ME_32_BYTES_HEX
# Secret used by the web dashboard / operator tools for admin endpoints
ADMIN_API_KEY=CHANGE_ME_32_BYTES_HEX

# Optional shared secret: require requests to pass through the Vercel API gateway.
# Set the same random value in Vercel as WORKER_PROXY_SECRET.
WORKER_PROXY_SECRET=

# AES-256-GCM key for bot token encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# Where uploaded bot sources are stored on the VPS
DATA_DIR=./data

# ----- Docker runner -------------------------------------------------------
# false = simulate containers (local development without Docker)
DOCKER_ENABLED=false
DOCKER_SOCKET_PATH=/var/run/docker.sock
BOT_RUNTIME_IMAGE=hostbot/runtime-node:22
BOT_MEMORY_MB=256
BOT_CPU_LIMIT=0.5
BOT_PIDS_LIMIT=128
BOT_STORAGE_MB=200
BOT_LOG_TAIL_LINES=150
INSTALL_TIMEOUT_MS=600000
START_TIMEOUT_MS=60000
# Isolated Docker bridge network for customer bots (ICC disabled).
BOT_DOCKER_NETWORK=hostbot-bots
# Source/token retention after a bot expires or is stopped.
DATA_RETENTION_DAYS=30
RECONCILE_INTERVAL_MS=60000

# Comma separated origins allowed to call the API from a browser (optional).
CORS_ORIGIN=

# ----- Management Discord bot ---------------------------------------------
# The bot reuses BOT_API_KEY / ADMIN_API_KEY from above. Do not create
# duplicate copies with different values.
DISCORD_TOKEN=YOUR_MANAGEMENT_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_APPLICATION_ID
# Only this guild may use the management bot
MANAGEMENT_GUILD_ID=YOUR_GUILD_ID
# Comma separated Discord user IDs with admin access
ADMIN_DISCORD_IDS=123456789012345678
# Channel that receives admin alerts (payment review, crashes, etc.)
ADMIN_LOG_CHANNEL_ID=123456789012345678
# Optional: register slash commands to a single guild (faster propagation)
DISCORD_DEV_GUILD_ID=
API_BASE_URL=http://localhost:3001
BOT_API_TIMEOUT_MS=60000

# ----- Payments ------------------------------------------------------------
BANK_NAME=국민은행
BANK_ACCOUNT_NUMBER=000000-00-000000
BANK_ACCOUNT_HOLDER=예금주
# Days a deposit request stays open
PAYMENT_REQUEST_DAYS=7
# Duplicate bank-app/SMS notification window (minutes)
PAYMENT_DEDUPE_WINDOW_MINUTES=10

# Pushbullet streaming access token (optional). Leave empty to disable.
# Requires the Android app with notification mirroring enabled.
PUSHBULLET_ACCESS_TOKEN=

# Optional generic notification webhook secret (for a custom Android forwarder)
NOTIFICATION_WEBHOOK_SECRET=

# ----- Optional malware scanning (ClamAV / clamd) -------------------------
# Leave CLAMAV_HOST empty to disable. When enabled, set CLAMAV_REQUIRED=true
# so a scanning outage blocks uploads instead of silently skipping the scan.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

# ----- Web dashboard (Vercel / local) -------------------------------------
# These three values belong in the Vercel project environment, not the VPS .env.
# API_BASE_URL must be reachable from Vercel (public HTTPS API URL).
DASHBOARD_PASSWORD=CHANGE_ME
DASHBOARD_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_BYTES
# ADMIN_API_KEY is reused from the API section above.
